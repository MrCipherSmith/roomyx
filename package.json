{
  "name": "@mrciphersmith/roomyx",
  "version": "0.4.0",
  "description": "MCP server + terminal UI for startup-room: live room status, chat, per-agent modal, an installable room registry, and skill-sync.",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/MrCipherSmith/roomyx.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "terminal-ui",
    "tui",
    "claude-code",
    "codex",
    "keryx",
    "bun",
    "cli"
  ],
  "bin": {
    "roomyx": "./src/cli.ts",
    "roomyx-client": "./src/client/index.ts"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "check": "bun run lint && bun run typecheck && bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@opentui/core": "^0.5.11",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "eslint": "^10.10.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
